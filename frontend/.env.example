# iQup Frontend — Environment Variables
# Copy this file to .env and fill in the values.

# Judge0 API key (for the Practice IDE code execution)
# Get one at: https://rapidapi.com/judge0-official/api/judge0-ce
VITE_JUDGE0_API_KEY=your_rapidapi_key_here

# Backend URL (default points to the hosted API)
# Change this if running the backend locally: http://localhost:5000
VITE_API_BASE_URL=http://localhost:5000