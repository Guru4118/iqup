# ─── Server ────────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=5000

# ─── Database ──────────────────────────────────────────────────────────────────
# MongoDB Atlas connection string
MONGO_URL=mongodb+srv://<user>:<password>@cluster.mongodb.net/iqup?retryWrites=true&w=majority

# ─── Redis ─────────────────────────────────────────────────────────────────────
# Upstash or Redis Cloud URL (rediss:// for TLS)
REDIS_URL=rediss://:<password>@<host>:<port>

# ─── JWT ───────────────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=<your-64-byte-hex-secret>

# ─── AI Service ────────────────────────────────────────────────────────────────
TOGETHER_API_KEY=<your-together-ai-api-key>

# ─── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=https://iqup.netlify.app,http://localhost:5173

# ─── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=info
